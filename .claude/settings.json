{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(uv:*)",
      "Bash(pnpm:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(docker compose:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform test:*)",
      "Bash(tflint:*)",
      "Bash(checkov:*)",
      "Bash(k6:*)",
      "Bash(./scripts/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(aws:*)"
    ]
  }
}
