# collections-copilot environment. Copy to .env (make bootstrap does it). All values are local,
# synthetic defaults; no real credentials belong in this file.

# --- application (CC_*) -------------------------------------------------------
CC_ENV=dev
CC_LOG_LEVEL=INFO
CC_PUBLIC_BASE_URL=http://localhost:8310
CC_DATABASE_URL=postgresql+psycopg://cc:cc@localhost:8320/cc
CC_REDIS_URL=redis://localhost:8330/0
CC_SSE_HEARTBEAT_S=15
CC_SCHEDULER_INTERVAL_S=30
CC_MAX_JSON_BYTES=1048576
CC_API_WORKERS=1
CC_RATE_LIMIT_PER_MINUTE=120
CC_WEBHOOK_RATE_LIMIT_PER_MINUTE=600
CC_REDIS_MAX_CONNECTIONS=200
CC_AWS_REGION=us-east-1
CC_SQS_ENDPOINT_URL=http://localhost:8340
CC_SQS_TASKS_QUEUE=cc-tasks
CC_SQS_REPLIES_QUEUE=cc-replies
CC_SQS_TASKS_DLQ=cc-tasks-dlq
CC_SQS_REPLIES_DLQ=cc-replies-dlq
CC_S3_ENDPOINT_URL=http://localhost:8341
# Host-reachable endpoint used in presigned URLs when the API runs inside Docker.
CC_S3_PUBLIC_ENDPOINT_URL=http://localhost:8341
CC_S3_BUCKET=cc-uploads
CC_OIDC_ISSUER=http://localhost:8345
CC_OIDC_JWKS_URL=http://localhost:8345/.well-known/jwks.json
CC_OIDC_AUDIENCE=cc-web
# LLM: fake (default, offline), anthropic or bedrock. Model IDs never carry date suffixes.
CC_LLM_PROVIDER=fake
CC_MODEL_FAST=claude-haiku-5-5
CC_MODEL_REASONING=claude-opus-5-5
CC_BEDROCK_MODEL_FAST=anthropic.claude-haiku-5-5
CC_BEDROCK_MODEL_REASONING=anthropic.claude-opus-5-5
CC_LLM_TIMEOUT_S=20
CC_LLM_MAX_RETRIES=2
CC_LLM_BREAKER_FAILURES=5
CC_LLM_BREAKER_RESET_S=60
CC_TWILIO_BASE_URL=http://localhost:8342
CC_TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
CC_TWILIO_AUTH_TOKEN=dev-twilio-auth-token
CC_TWILIO_FROM=+15550001000
CC_MCPGW_URL=http://localhost:8344/mcp
CC_MCPGW_ADMIN_URL=http://localhost:8348
CC_MCPGW_ISSUER_URL=http://localhost:8349
CC_MCPGW_WEBHOOK_SECRET=dev-mcpgw-webhook-secret
# dev = gateway dev issuer (local); kms = KMS-signed tokens (AWS)
CC_AGENT_TOKEN_PROVIDER=dev
CC_AGENT_KMS_KEY_ID=
CC_AGENT_ISSUER=collections-copilot
CC_SMTP_HOST=localhost
CC_SMTP_PORT=8346
CC_SMTP_FROM=copilot@collections.example
CC_SUPERVISOR_EMAIL=supervisors@collections.example
CC_AUTO_APPROVE_MAX_USD=500
CC_AUTO_APPROVE_MIN_CONFIDENCE=0.9
CC_WORKER_CONCURRENCY=8
CC_RATE_LIMIT_PER_MIN=120
CC_UPLOAD_MAX_BYTES=10485760
CC_UPLOAD_MAX_ROWS=20000
CC_JSON_MAX_BYTES=1048576
CC_OTEL_EXPORTER_OTLP_ENDPOINT=
# Local Grafana admin (profile observability, bound to 127.0.0.1); dummy value.
GF_SECURITY_ADMIN_PASSWORD=cc-local-admin
CC_METRICS_PORT=8311
CC_DEMO_MODE=offline

# --- shared / third-party -----------------------------------------------------
# Dummy credentials for ElasticMQ and MinIO; in AWS the task role is used instead.
AWS_ACCESS_KEY_ID=cclocal
AWS_SECRET_ACCESS_KEY=cclocalsecret
AWS_DEFAULT_REGION=us-east-1
# Only for `make eval-live` / `make record-fixtures`; leave empty for offline work.
ANTHROPIC_API_KEY=
LIVE_EVAL_BUDGET_USD=2
# Web BFF (Next.js)
WEB_SESSION_SECRET=dev-only-session-secret-change-me-32bytes!!
WEB_ALLOW_DEV_SECRET=true
WEB_API_BASE_URL=http://localhost:8310
WEB_OIDC_ISSUER=http://localhost:8345
WEB_OIDC_PUBLIC_ISSUER=http://localhost:8345
WEB_OIDC_CLIENT_ID=cc-web
WEB_PUBLIC_URL=http://localhost:8300
# mcp-gateway fallback
MCPGW_DATABASE_URL=postgresql://cc:cc@localhost:8320/cc
MCPGW_UPSTREAMS=ledger=http://localhost:8343/mcp
MCPGW_POLICY_FILE=deploy/mcpgw/policy/collections.yaml
MCPGW_APPROVAL_WEBHOOK_URL=http://localhost:8310/api/v1/webhooks/mcpgw/approvals
MCPGW_APPROVAL_WEBHOOK_SECRET=dev-mcpgw-webhook-secret
MCPGW_APPROVAL_TTL_SECONDS=900
MCPGW_DEV_ISSUER=true
# ledger-mcp
LEDGER_DATABASE_URL=postgresql://cc:cc@localhost:8320/cc
# dev-oidc
DEV_OIDC_ISSUER=http://localhost:8345
DEV_OIDC_CLIENT_IDS=cc-web
DEV_OIDC_ALLOW_DIRECT_TOKENS=true
# debtor-sim (demo only; synthetic numbers)
DEBTOR_SIM_WIREMOCK_URL=http://localhost:8342
DEBTOR_SIM_API_URL=http://localhost:8310
DEBTOR_SIM_PERSONA=auto
DEBTOR_SIM_REPLY_DELAY_S=1.0
# Outside production only +1555… and +34555… numbers are accepted and texted.
CC_SYNTHETIC_NUMBERS_ONLY=true
# Progress streams (SSE): their own Redis pool, and open streams per user.
CC_SSE_MAX_CONNECTIONS=200
CC_SSE_STREAMS_PER_USER=5
# Optional OIDC endpoints when they are not under the issuer (Cognito's hosted UI).
# WEB_OIDC_AUTHORIZE_URL=
# WEB_OIDC_TOKEN_URL=
# WEB_OIDC_JWKS_URL=
# WEB_OIDC_LOGOUT_URL=
